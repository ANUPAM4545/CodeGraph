{
  "name": "codegraph-vscode",
  "displayName": "CodeGraph",
  "description": "Developer-native architectural intelligence.",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codegraph.login",
        "title": "CodeGraph: Login"
      },
      {
        "command": "codegraph.logout",
        "title": "CodeGraph: Logout"
      },
      {
        "command": "codegraph.explainThis",
        "title": "CodeGraph: Explain This"
      },
      {
        "command": "codegraph.analyzeImpact",
        "title": "CodeGraph: Analyze Impact"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codegraph-sidebar",
          "title": "CodeGraph",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codegraph-sidebar": [
        {
          "type": "webview",
          "id": "codegraph.sidebarView",
          "name": "CodeGraph"
        }
      ]
    },
    "configuration": {
      "title": "CodeGraph",
      "properties": {
        "codegraph.enableCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Enable architectural CodeLens annotations."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "esbuild": "^0.19.2",
    "eslint": "^8.47.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "ws": "^8.13.0"
  }
}
